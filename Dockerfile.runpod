FROM nvidia/cuda:12.1.0-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV UV_LINK_MODE=copy
ENV PATH="/root/.local/bin:/workspace/.venv/bin:${PATH}"

WORKDIR /workspace

RUN apt-get update && apt-get install -y \
    git \
    curl \
    wget \
    ffmpeg \
    libsndfile1 \
    build-essential \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN curl -LsSf https://astral.sh/uv/install.sh | sh

COPY .python-version pyproject.toml uv.lock README.md /workspace/

RUN uv python install 3.10
RUN uv sync --frozen

RUN mkdir -p /workspace/weights/stage1 /workspace/weights/stage2 /workspace/datasets/Feature

COPY configs /workspace/configs
COPY scripts /workspace/scripts
COPY src /workspace/src
COPY Makefile CITATION.cff LICENSE /workspace/
COPY weights/stage1/stage1_20260510_051049_seed42_f10.7619_ep044_lr2e-05_wd5e-04_d128_l1.pt /workspace/weights/stage1/
COPY PseudoLabel_all_distilbert_zdist_q30_70.npz /workspace/

COPY nested_learning /workspace/nested_learning
RUN uv pip install -e /workspace/nested_learning --no-deps


COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]

CMD ["bash"]