FROM nvidia/cuda:12.1.0-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV UV_LINK_MODE=copy
ENV PATH="/root/.local/bin:/workspace/.venv/bin:${PATH}"

WORKDIR /workspace

RUN apt-get update && apt-get install -y \
    git \
    curl \
    wget \
    ffmpeg \
    libsndfile1 \
    build-essential \
    ca-certificates \
    openssh-server \
    tmux \
    htop \
    && mkdir -p /var/run/sshd \
    && echo 'PermitRootLogin prohibit-password' >> /etc/ssh/sshd_config \
    && echo 'PubkeyAuthentication yes' >> /etc/ssh/sshd_config \
    && rm -rf /var/lib/apt/lists/*

RUN curl -LsSf https://astral.sh/uv/install.sh | sh

COPY .python-version pyproject.toml uv.lock README.md /workspace/

RUN uv python install 3.10
RUN uv sync --frozen

RUN mkdir -p /workspace/weights/stage1 /workspace/weights/stage2 /workspace/datasets/Feature

COPY configs /workspace/configs
COPY scripts /workspace/scripts
COPY src /workspace/src
COPY Makefile CITATION.cff LICENSE /workspace/
COPY weights/stage1/stage1_20260510_051049_seed42_f10.7619_ep044_lr2e-05_wd5e-04_d128_l1.pt /workspace/weights/stage1/
COPY weights/stage1/stage1_20260513_082404_seed42_f10.7018_ep025_lr1e-04_wd1e-04_d64_l1.pt /workspace/weights/stage1/
COPY weights/stage1/stage1_20260513_174400_seed42_f10.7018_ep032_lr1e-04_wd1e-04_d32_l1.pt /workspace/weights/stage1/
COPY weights/stage1/stage1_20260514_052912_seed42_f10.7059_ep043_lr1e-04_wd1e-04_d256_l1.pt /workspace/weights/stage1/
COPY weights/stage1/stage1_20260517_102119_seed42_f10.7059_ep046_lr1e-04_wd1e-04_d256_l1.pt /workspace/weights/stage1/
COPY PseudoLabel_all_distilbert_zdist_q30_70.npz /workspace/

COPY nested_learning /workspace/nested_learning
ENV PYTHONPATH="/workspace/nested_learning/src:${PYTHONPATH}"
RUN uv pip install -e . --no-deps

RUN echo 'export PATH="/root/.local/bin:/workspace/.venv/bin:$PATH"' >> /root/.bashrc && \
    echo 'export PYTHONPATH="/workspace/nested_learning/src:$PYTHONPATH"' >> /root/.bashrc && \
    echo 'cd /workspace' >> /root/.bashrc

COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]

